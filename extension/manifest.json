{
  "manifest_version": 3,
  "name": "cleanbrowse control",
  "version": "0.1.0",
  "description": "Start a clean, wiped-but-extensions-kept browsing session from inside the browser.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "cleanbrowse"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
